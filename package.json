{
  "name": "hello_youtube",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently -k \"npm:tailwind:watch\" \"npm:react-start\"",
    "react-start": "set PORT=3002&&react-scripts start",
    "tailwind:watch": "npx @tailwindcss/cli -i ./src/index.css -o ./src/tailwind.generated.css --watch",
    "tailwind:build": "npx @tailwindcss/cli -i ./src/index.css -o ./src/tailwind.generated.css --minify",
    "build": "npm run tailwind:build && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  }
}
